  "facts_from_source_or_labeled_arithmetic": [
    {
      "id": "E01",
      "type": "workflow",
      "locator": "§2.1–2.3, physical3–4 / printed1950–1951",
      "object": "seed selection, operator selection, mutated input generation, target execution, feedback",
      "claim": "mutation scheduling changes operator selection; it does not replace seed selection or add mutation operators",
      "notes": "One generated input can involve several mutation operators; invocation count and input count are different"
    },
    {
      "id": "E02",
      "type": "motivation_observation",
      "locator": "§2.4, Figures3–5, physical4–5 / printed1951–1952",
      "object": "interesting input contribution shares in deterministic stage; invocation counts for avconv; stage time and findings for four programs",
      "claim": "supports motivation for different allocation of mutation opportunities",
      "not_supported": "Fig3 shares are not already-normalized per-call success probabilities or causal operator contributions; deterministic observations are not a direct controlled havoc causal experiment"
    },
    {
      "id": "E03",
      "type": "online_proxy",
      "locator": "§3.3.2, physical6 / printed1953",
      "object": "local operator efficiency",
      "numerator": "interesting test cases contributed by that operator during one iteration",
      "denominator": "invocations of that operator during that iteration",
      "stored_best": "probability position where historical local ratio was highest",
      "not_equivalent_to": [
        "confirmed vulnerabilities per second",
        "global contribution fraction",
        "swarm interesting inputs per generated input"
      ]
    },
    {
      "id": "E04",
      "type": "online_proxy",
      "locator": "§3.3.3, physical6 / printed1953; §4.1.3 physical8 / printed1955",
      "object": "operator global position",
      "numerator": "cumulative interesting input contributions by the operator across swarms through current time",
      "denominator": "cumulative contributions across all operators used to form distribution",
      "not_supported": "one common best position for all particles; per-call normalization; unbiased or causal marginal benefit"
    },
    {
      "id": "E05",
      "type": "online_proxy",
      "locator": "§3.3.4, physical6 / printed1953; §4.1.2 physical8 / printed1955",
      "object": "swarm efficiency used to choose distribution for core fuzzing",
      "numerator": "interesting inputs contributed by swarm in an iteration",
      "denominator": "new test cases generated by swarm in iteration",
      "purpose": "pilot compares candidate distributions; core uses selected distribution"
    },
    {
      "id": "E06",
      "type": "stage_control",
      "locator": "§4.2, physical8 / printed1955",
      "object": "AFL-family pacemaker",
      "trigger": "after finishing mutation of one seed, no new unique crash or path for user-set duration T",
      "action": "selectively disable deterministic stage on following test cases",
      "value": "more seed testing opportunities and more havoc-stage probability updates within elapsed time",
      "variants": {
        "tmp": "re-enables deterministic stage after a threshold of new interesting inputs",
        "ever": "does not re-enable it"
      },
      "scope": "not used for VUzzer, which lacks this deterministic stage"
    },
    {
      "id": "E07",
      "type": "main_experiment_scope",
      "locator": "§5.1–5.3, physical8–9 / printed1955–1956",
      "budget": "240 hours per experiment",
      "programs": 13,
      "baseline": "AFL 2.52b",
      "initial_seeds": "100 selected files per program, common initial set for all compared fuzzers on the given program",
      "hardware": "one CPU core, 2.40GHz E5-2640 V4; 4.5GB RAM; Ubuntu16.04 64-bit",
      "not_supported": "all integrated fuzzers each evaluated on all13 programs; main values represent30-trial estimates"
    },
